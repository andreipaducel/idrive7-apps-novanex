    {"key": "brightMax", "label": "Luminozitate maxima", "type": "number", "default": 254, "steps": [100, 140, 180, 220, 254],
     "group": "Luminozitate (mod Complet)", "when": {"engine": "full", "effect": ["breathe", "strobe"]}},
    {"key": "duty", "label": "Strobe: cat sta aprins", "type": "number", "unit": "%", "default": 50, "steps": [10, 20, 30, 50, 70, 90],
